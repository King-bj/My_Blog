# Docker 部署环境变量配置示例
# 复制此文件为 .env 并根据需要修改（.env 已在 .gitignore 中忽略）

# 用户权限配置（Linux 系统，id -u 和 id -g）
USER_ID=1001
GROUP_ID=1001

# 应用配置
BLOG_PORT=3131
DATA_PATH=/path/to/your/blog-data

# 重新验证密钥（使用 openssl rand -hex 32 生成）
REVALIDATE_SECRET=your-very-secure-secret-key-change-this

# 站点配置
SITE_URL=https://your-blog.com

# 社交媒体链接（可选）
GITHUB_URL=https://github.com/your-username
EMAIL=your@email.com
TWITTER_URL=

# 管理后台密码（可选）
ADMIN_PASSWORD=ChangeMe123!
